PORT=3000
BASE_URL=http://localhost:3000
# Firma de sesiones. En producción es OBLIGATORIO (mínimo 32 caracteres, propio y aleatorio) o el servidor no arranca. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sin valor se usa uno temporal (solo para desarrollo: las sesiones se cierran al reiniciar).
SESSION_SECRET=
# Correo (SMTP). Obligatorio en producción: el registro envía un código de verificación al correo institucional y sin SMTP nadie puede registrarse.
# En desarrollo, sin SMTP, el código se imprime en la consola del servidor.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=clave
# SMTP_FROM=SAE <sae@uan.edu.mx>
# Dominio(s) de correo aceptados al registrarse cuando el padrón no trae el correo de la matrícula (separados por coma; incluye subdominios). Por defecto uan.edu.mx.
# DOMINIOS_CORREO=uan.edu.mx
# Detrás de Nginx u otro proxy de confianza: número de proxies (normalmente 1). Sin esto el límite de intentos vería la IP del proxy.
# TRUST_PROXY=1
# Zona horaria (IANA) de la Unidad Académica: decide qué horarios ya pasaron. Por defecto America/Mazatlan (UTC-7, Nayarit).
# ZONA_HORARIA=America/Mazatlan
# Máximo de asesorías activas (pendientes o confirmadas, aún por venir) por estudiante. Por defecto 2.
# MAX_ASESORIAS_ACTIVAS=2
